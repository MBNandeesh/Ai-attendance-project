# Copy to .env and fill in real values.

# Database — SQLite locally; Neon Postgres in production, e.g.:
# postgresql+psycopg://user:password@ep-xxx.aws.neon.tech/attendance?sslmode=require
DATABASE_URL=sqlite:///./attendance.db

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production-32+bytes

# Comma-separated origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development
